# Sao chép file này thành .env.local rồi điền giá trị (Supabase → Project Settings → API)
# Chỉ dùng anon / publishable key. TUYỆT ĐỐI không dùng service_role / secret key.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# Base path khi build (thường để trống khi chạy máy; GitHub Actions tự tính)
# VITE_BASE_PATH=/MY-TREK/
